HOST=127.0.0.1
PORT=5000
JSON_BODY_LIMIT=16kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
LOG_LEVEL=info
# Server Environment Variables (Private - Never expose to client)
NODE_ENV=development

# Authentication upstreams. Both URLs must be fixed HTTPS endpoints.
AUTH_API_URL=https://auth.example.com/validate
AUTH_API_TIMEOUT_MS=8000
LOGIN_RATE_LIMIT_MAX=10
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
# Or comma-separated trusted proxy IPs/CIDRs; never set this to true.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL_SECONDS=900
PROFILE_SETUP_TTL_SECONDS=600
PROOF_UPLOAD_DIR=private-uploads/permission-proofs
PROOF_UPLOAD_MAX_BYTES=10485760

# Database Configuration (MSSQL)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=DPDPRAF
DB_USER=dpdp_raf_service
DB_PASSWORD=replace_with_database_secret
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MAX=10

# Copy to .env for local development; never commit real credentials.

